        { "key": "deal", "label": "Lead with it", "type": "bool", "section": "Stock", "hint": "Shown on a tinted card on the home page. The first three are used." },
        { "key": "month", "label": "Bike of the month", "type": "bool", "section": "Stock" },
        { "key": "wheel", "label": "Wheel size", "type": "text", "options": [["29", "29 inch"], ["mixed", "Mixed 29 / 27.5 inch"]], "section": "Specification" },
