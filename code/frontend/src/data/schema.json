{
  "collections": {
    "products": {
      "label": "Bikes",
      "fields": [
        { "key": "image", "label": "Photograph", "type": "image", "section": "Basics", "hint": "The whole bike, side on, on a plain white backdrop. Every bike card is 4:3." },
        { "key": "name", "label": "Model", "type": "text", "required": true, "section": "Basics" },
        { "key": "brand", "label": "Brand", "type": "text", "options": ["Giant", "Liv"], "section": "Basics" },
