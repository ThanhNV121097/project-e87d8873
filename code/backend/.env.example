# Backend environment. Copy to .env for a run outside Docker; never commit .env.

# Postgres connection string. The runtime injects it; docker compose builds it
# from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in the root .env.
# The backend reads this whole string and never assembles one from parts.
DATABASE_URL=postgres://app:app_secret@localhost:5432/app?sslmode=disable

# Port the HTTP server listens on. The image sets PORT=8080 and compose
# health-checks it there. Falls back to APP_PORT, then 8080.
PORT=8080

# Fallback for PORT when PORT is unset.
APP_PORT=8080

# --- The owner's account (admin story, ADMIN-001) ---------------------------
# The backend reads these two from that story onward. Both are secrets the
# owner enters in the console; they are never written in the repository and
# nothing ever prints them. While either is empty nobody can sign in.

# The owner's sign-in email. Compared ignoring capitals and surrounding spaces.
ADMIN_EMAIL=

# The owner's password. The server keeps only a salted slow hash of it.
ADMIN_PASSWORD=
