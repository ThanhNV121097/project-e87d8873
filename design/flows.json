[
  {
    "name": "From the heading's pill to the shop",
    "steps": [
      {
        "action": "open",
        "path": "/"
      },
      {
        "action": "click",
        "selector": "[data-testid='hero-cta']"
      },
      {
        "action": "expect",
        "selector": "[data-testid='shop-count']"
      }
    ]
  },
  {
    "name": "Open a thing from its tinted card",
    "steps": [
      {
        "action": "open",
        "path": "/"
      },
      {
        "action": "click",
        "selector": "[data-testid='tint-stoneware-teapot']"
      },
      {
        "action": "expect",
        "selector": "[data-testid='product-name']",
        "text": "Stoneware Teapot"
      }
    ]
  },
  {
    "name": "Put a thing in the bag and check out",
    "steps": [
      {
        "action": "open",
        "path": "/shop/stoneware-teapot"
      },
      {
        "action": "click",
        "selector": "[data-testid='product-add']"
      },
      {
        "action": "open",
        "path": "/bag"
      },
      {
        "action": "expect",
        "selector": "[data-testid='bag-line-stoneware-teapot']"
      },
      {
        "action": "click",
        "selector": "[data-testid='bag-checkout']"
      },
      {
        "action": "expect",
        "selector": "[data-testid='place-order']"
      }
    ]
  },
  {
    "name": "Open a department from its wordmark",
    "steps": [
      {
        "action": "open",
        "path": "/"
      },
      {
        "action": "click",
        "selector": "[data-testid='mark-audio']"
      },
      {
        "action": "expect",
        "selector": "[data-testid='card-over-ear']"
      }
    ]
  }
]
