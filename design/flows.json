[
  {
    "name": "From the heading's pill to all the bikes",
    "steps": [
      { "action": "open", "path": "/" },
      { "action": "click", "selector": "[data-testid='hero-cta']" },
      { "action": "expect", "selector": "[data-testid='shop-count']" }
    ]
  },
  {
    "name": "Open a bike from its tinted card",
    "steps": [
      { "action": "open", "path": "/" },
      { "action": "click", "selector": "[data-testid='tint-stance-0']" },
      { "action": "expect", "selector": "[data-testid='product-name']", "text": "Stance 0" }
    ]
  },
  {
    "name": "Narrow the bikes to trail bikes and open one",
    "steps": [
      { "action": "open", "path": "/shop" },
      { "action": "click", "selector": "[data-testid='chip-trail']" },
      { "action": "click", "selector": "[data-testid='card-trance-x-1']" },
      { "action": "expect", "selector": "[data-testid='product-name']", "text": "Trance X 1" }
    ]
  },
  {
    "name": "Choose a size, put the bike in the bag and check out",
    "steps": [
      { "action": "open", "path": "/shop/talon-2" },
      { "action": "click", "selector": "[data-testid='size-M']" },
      { "action": "click", "selector": "[data-testid='product-add']" },
      { "action": "open", "path": "/bag" },
      { "action": "expect", "selector": "[data-testid='bag-line-talon-2']" },
      { "action": "click", "selector": "[data-testid='bag-checkout']" },
      { "action": "type", "selector": "#order-name", "value": "Minh" },
      { "action": "click", "selector": "[data-testid='pay-transfer']" },
      { "action": "expect", "selector": "[data-testid='checkout-total']" },
      { "action": "expect", "selector": "[data-testid='place-order']", "text": "18.990.000" }
    ]
  },
  {
    "name": "Ask the shop about a bike",
    "steps": [
      { "action": "open", "path": "/shop/trance-x-1" },
      { "action": "click", "selector": "[data-testid='product-ask']" },
      { "action": "expect", "selector": "[data-testid='ask-form']" }
    ]
  },
  {
    "name": "Search the whole shop for a workshop job",
    "steps": [
      { "action": "open", "path": "/" },
      { "action": "click", "selector": "[data-testid='open-search']" },
      { "action": "type", "selector": "[data-testid='search-input']", "value": "bleed" },
      { "action": "press", "selector": "[data-testid='search-input']", "key": "Enter" },
      { "action": "click", "selector": "[data-testid='search-in-services']" },
      { "action": "expect", "selector": "[data-testid='search-services']", "text": "250.000" }
    ]
  },
  {
    "name": "Open a department from its wordmark",
    "steps": [
      { "action": "open", "path": "/" },
      { "action": "click", "selector": "[data-testid='mark-e-mtb']" },
      { "action": "expect", "selector": "[data-testid='card-talon-e-plus-1']" }
    ]
  }
]
